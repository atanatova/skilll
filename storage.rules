// ============================================================
// Firebase Storage Security Rules for SkillSwap
// Deploy via: Firebase Console → Storage → Rules
// ============================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: only the owner can upload/delete, anyone authenticated can read
    match /profile_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chat images: only participants can upload, anyone authenticated can read
    match /chat_images/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
